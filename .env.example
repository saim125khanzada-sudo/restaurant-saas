# ==========================================
# RESTAURANT MANAGEMENT SAAS CONFIGURATION
# ==========================================

# Database & Cache
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=restaurant_saas_dev;Username=postgres;Password=postgres_secure_dev_password_123!
REDIS_CONNECTION_STRING=localhost:6379

# Security & JWT
JWT_SECRET=Min64CharactersLongCryptographicallySecureRandomSecretKeyForTokenSigning2026!
JWT_ISSUER=RestaurantSaaS.Api
JWT_AUDIENCE=RestaurantSaaS.Clients
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Cloud Object Storage (S3 / Cloudflare R2 / MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadminpassword123!
OBJECT_STORAGE_BUCKET_NAME=restaurant-assets

# Push Notifications (Firebase Cloud Messaging HTTP v1)
FIREBASE_CREDENTIAL_PATH=./secrets/firebase-adminsdk.json

# Google Maps Platform
GOOGLE_MAPS_API_KEY=AIzaSy_REPLACE_WITH_RESTRICTED_GOOGLE_MAPS_KEY

# External Fiscal & Payment Placeholders (To be configured in Phase 7 & 9)
PAYMENT_GATEWAY_API_KEY=PLACEHOLDER_PAYMENT_SECRET
FBR_ENVIRONMENT=Sandbox
FBR_POS_REGISTRATION_NUMBER=PLACEHOLDER_FBR_ID
FBR_BEARER_TOKEN=PLACEHOLDER_FBR_TOKEN
